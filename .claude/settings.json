{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:jekyllrb.com)",
      "WebFetch(domain:kramdown.gettalong.org)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.micropython.org)",
      "WebFetch(domain:viper-ide.org)",
      "WebFetch(domain:creativecommons.org)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(gh repo *)",
      "Bash(gh repo:*)",
      "Bash(gh api *)",
      "Bash(gh api:*)"
    ],

    "deny": [
      "Bash(sudo *)",
      "Bash(sudo:*)",
      "Bash(rm -rf *)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git filter-branch *)",
      "Bash(gem push *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(//Users/**/.ssh/**)",
      "Read(//Users/**/.aws/**)",
      "Read(//Users/**/.config/gh/**)",
      "Write(./source/**)",
      "Edit(./source/**)"
    ]
  }
}